async function loadMantle() {
  for (const url of config.mantleFallbacks) {
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error('bad response');
      const text = await response.text();
      if (text.trim()) {
        renderPayload(text);
        return;
      }
    } catch (err) {
      // keep trying
    }
  }
  showError('ERR_MANTLE_FETCH');
}
